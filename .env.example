# PostgreSQL (required). Prisma provider is postgresql — SQLite file URLs will not work.
#
# Local: Docker Postgres, a Neon branch, or any Postgres 14+.
#   docker run --name tfo-pg -e POSTGRES_PASSWORD=postgres -e POSTGRES_DB=temp_fence_ops -p 5432:5432 -d postgres:16
#   DATABASE_URL="postgresql://postgres:postgres@localhost:5432/temp_fence_ops?schema=public"
#
# Neon (demo / production): copy the connection string from the Neon console.
#   prisma migrate deploy needs the direct (non-pooler) URL.
#   Runtime can use the pooled URL if you split env vars later; this app uses one DATABASE_URL.
#   DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
#
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/temp_fence_ops?schema=public"

# Signed session cookie secret (required). Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-long-random-string"
