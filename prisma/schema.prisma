// Temp Fence Ops — Prisma schema
// PostgreSQL for local, demo, and company deploy (Neon or Docker).
// See .env.example and README for DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  employees      Employee[]
  inventoryItems InventoryItem[]
  jobs           Job[]
  adjustments    InventoryAdjustment[]
  yardExpenses   YardExpense[]
  writeOffs      WriteOff[]
  transfersFrom  Transfer[] @relation("TransferFrom")
  transfersTo    Transfer[] @relation("TransferTo")
}

model Employee {
  id         String   @id @default(cuid())
  name       String
  nameKey    String   @unique
  hourlyRate Float
  position   String
  branchId   String
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  branch Branch     @relation(fields: [branchId], references: [id])
  labor  JobLabor[]
}

model InventoryItem {
  id          String   @id @default(cuid())
  sku         String
  name        String
  description String?
  unit        String   @default("ea")
  reusable    Boolean  @default(true)
  branchId    String
  startingQty Float    @default(0)
  unitCost    Float    @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch            Branch                @relation(fields: [branchId], references: [id])
  materials         JobMaterial[]
  adjustments       InventoryAdjustment[]
  writeOffs         WriteOff[]
  variances         JobMaterialVariance[]
  transferLinesFrom TransferLine[]        @relation("TransferLineFrom")
  transferLinesTo   TransferLine[]        @relation("TransferLineTo")

  @@unique([branchId, sku])
}

model Job {
  id          String   @id @default(cuid())
  date        DateTime
  branchId    String
  class       String? // EVENT, CONSTRUCTION, OTHER; Site Walk: Non Pay, Site Visit
  orderNumber String
  customer    String
  address     String?
  city        String?
  jobType     String // Install, Pickup, Drop, Other, Site Walk
  /// Active | Cancelled (Title Case). Cancelled stays on Jobs / day list; inventory sign 0; excluded from P&L.
  status      String   @default("Active")
  fenceType   String? // canonical: CL6, CL8, CL6+1, CL8+1, 6x10, 6x12, 8x10, 8x12, BARRICADE
  qtyLf       Float?
  screen      Boolean  @default(false)
  /// Screen SKU (BLACK6, …). `screen` is derived as Boolean(screenSku) for legacy views.
  screenSku   String?
  gates       Int      @default(0) // denormalized gateQty + gateQty2
  gateType    String?
  gateQty     Int      @default(0)
  gateType2   String?
  gateQty2    Int      @default(0)
  topRail     Boolean  @default(false)
  bottomRail  Boolean  @default(false)
  /// BFOOT | SBAG — panel T-stand weights. Blank = none.
  weightMode  String?
  /// Chainlink only (denormalized from first chainlink section): driven | plate.
  postMount   String?
  /// Corners + start/stop + extras (not including 2 per gate). Denormalized sum across sections.
  terminalsManual Int  @default(0)
  /// Source of truth for multi-section BOM. Null = one section from the columns above.
  fenceSections Json?
  notes       String?
  accountExec String?
  revenue     Float    @default(0)
  /// Denormalized sum of lodgingLines (kept for simple rollups / legacy seed)
  lodging     Float    @default(0)
  /// Denormalized sum of freightLines
  freight     Float    @default(0)
  /// Denormalized sum of miscLines
  misc        Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch       Branch                @relation(fields: [branchId], references: [id])
  materials    JobMaterial[]
  labor        JobLabor[]
  lodgingLines JobLodgingLine[]
  freightLines JobFreightLine[]
  miscLines    JobMiscLine[]
  variances    JobMaterialVariance[]

  @@index([orderNumber])
  @@index([date])
  @@index([branchId])
}

model JobMaterial {
  id              String  @id @default(cuid())
  jobId           String
  inventoryItemId String?
  itemName        String? // free-text when not linked to catalog
  quantity        Float
  notes           String?

  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
}

model JobLabor {
  id            String @id @default(cuid())
  jobId         String
  employeeId    String
  regularHours  Float  @default(0)
  overtimeHours Float  @default(0)

  job      Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id])
}

model JobLodgingLine {
  id       String  @id @default(cuid())
  jobId    String
  amount   Float
  facility String?
  notes    String?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JobFreightLine {
  id      String  @id @default(cuid())
  jobId   String
  company String?
  cost    Float
  notes   String?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

model JobMiscLine {
  id       String  @id @default(cuid())
  jobId    String
  amount   Float
  category String?
  notes    String?

  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
}

/// Job-tied material qty adjustments (damaged on site / lost / extra / returned).
/// quantity is the inventory delta: negative removes from yard, positive returns.
model JobMaterialVariance {
  id              String  @id @default(cuid())
  jobId           String
  inventoryItemId String?
  itemName        String?
  quantity        Float
  reason          String
  notes           String?

  job           Job            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation(fields: [inventoryItemId], references: [id])
}

model InventoryAdjustment {
  id              String   @id @default(cuid())
  inventoryItemId String
  branchId        String
  quantityDelta   Float // positive = add to on-hand, negative = remove
  reason          String?
  adjustedAt      DateTime @default(now())
  createdAt       DateTime @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])
  branch        Branch        @relation(fields: [branchId], references: [id])
}

model Vendor {
  id        String   @id @default(cuid())
  name      String
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  yardExpenses YardExpense[]
}

model YardExpense {
  id          String   @id @default(cuid())
  date        DateTime
  branchId    String
  category    String // PPE | Consumables | Tools | Food | Equipment | Other
  vendorId    String?
  vendorText  String? // optional free-text when no Vendor row
  amount      Float
  purchasedBy String
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  branch Branch  @relation(fields: [branchId], references: [id])
  vendor Vendor? @relation(fields: [vendorId], references: [id])

  @@index([date])
  @@index([branchId])
}

/// Yard-to-yard stock move. Excluded from job analytics.
/// Carry cost conceptually; Wave 3 will refine avg cost on InventoryItem.
model Transfer {
  id           String   @id @default(cuid())
  date         DateTime
  fromBranchId String
  toBranchId   String
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  fromBranch Branch         @relation("TransferFrom", fields: [fromBranchId], references: [id])
  toBranch   Branch         @relation("TransferTo", fields: [toBranchId], references: [id])
  lines      TransferLine[]

  @@index([date])
}

model TransferLine {
  id                  String @id @default(cuid())
  transferId          String
  fromInventoryItemId String
  toInventoryItemId   String
  quantity            Float
  notes               String?

  transfer          Transfer      @relation(fields: [transferId], references: [id], onDelete: Cascade)
  fromInventoryItem InventoryItem @relation("TransferLineFrom", fields: [fromInventoryItemId], references: [id])
  toInventoryItem   InventoryItem @relation("TransferLineTo", fields: [toInventoryItemId], references: [id])
}

/// Damaged / scrap / shrink write-offs. Qty down. Excluded from job analytics.
model WriteOff {
  id              String   @id @default(cuid())
  date            DateTime
  branchId        String
  inventoryItemId String
  quantity        Float
  reason          String // damaged | scrap | shrink
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch        Branch        @relation(fields: [branchId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([date])
  @@index([branchId])
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         String   @default("office") // admin | office
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Yard / office to-do. Open days are computed (not stored): calendar days from `date` to today while Open.
model ActionItem {
  id          String    @id @default(cuid())
  date        DateTime
  task        String
  assignedTo  String?
  notes       String?
  status      String    @default("Open") // Open | Done
  completedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status])
  @@index([date])
}
